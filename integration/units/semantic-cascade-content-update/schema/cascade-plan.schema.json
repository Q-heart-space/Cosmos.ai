{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://q-heart-space.github.io/contracts/semantic-cascade/cascade-plan-v1.json",
  "title": "SemanticCascadePlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["change_id", "semantic_units", "targets", "approval", "rollback"],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "semantic_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "change_kind", "evidence"],
        "properties": {
          "unit": {"type": "string", "minLength": 1},
          "change_kind": {"enum": ["content", "behavior", "wiring", "mixed", "none"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "uncertainty": {"enum": ["known", "unknown", "not_ready"]}
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_ref", "operation", "before_sha256", "expected_after_sha256"],
        "properties": {
          "target_ref": {"type": "string", "minLength": 1},
          "operation": {"enum": ["create", "modify", "rename", "deprecate", "verify_only"]},
          "locator": {"type": ["string", "null"]},
          "before_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "expected_after_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "state"],
      "properties": {
        "required": {"type": "boolean"},
        "state": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "owner_ref": {"type": ["string", "null"]}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "rollback_ref"],
      "properties": {
        "available": {"type": "boolean"},
        "rollback_ref": {"type": ["string", "null"]}
      }
    }
  }
}
